@page "{id}"
@model FreebetTracker.Web.Pages.Freebets.EditModel

@{
    ViewData["Title"] = "Rediger freebet";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.Player" class="form-label"></label>
        <div class="autocomplete-container" data-autocomplete data-autocomplete-options="@System.Text.Json.JsonSerializer.Serialize(Model.PlayerSuggestions)">
            <input asp-for="Input.Player" class="form-control" data-autocomplete-input autocomplete="off" placeholder="Vælg eller indtast spiller" />
            <ul class="autocomplete-list" data-autocomplete-list id="playerSuggestions" role="listbox" hidden></ul>
        </div>
        <span asp-validation-for="Input.Player" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Account" class="form-label"></label>
        <div class="autocomplete-container" data-autocomplete data-autocomplete-options="@System.Text.Json.JsonSerializer.Serialize(Model.AccountSuggestions)">
            <input asp-for="Input.Account" class="form-control" data-autocomplete-input autocomplete="off" placeholder="Vælg eller indtast konto" />
            <ul class="autocomplete-list" data-autocomplete-list id="accountSuggestions" role="listbox" hidden></ul>
        </div>
        <span asp-validation-for="Input.Account" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Amount" class="form-label"></label>
        <input asp-for="Input.Amount"
               type="number"
               min="1"
               max="1000000"
               step="1"
               class="form-control" />
        <span asp-validation-for="Input.Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ExpiryDate" class="form-label"></label>
        <input asp-for="Input.ExpiryDate" type="date" class="form-control" />
        <span asp-validation-for="Input.ExpiryDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ExpiryTime" class="form-label"></label>
        <input asp-for="Input.ExpiryTime"
               type="time"
               step="60"
               class="form-control" />
        <span asp-validation-for="Input.ExpiryTime" class="text-danger"></span>
        <div class="form-text">
            Efterlad blank hvis du ikke ønsker at angive et specifikt tidspunkt for udløb.
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Terms" class="form-label"></label>
        <textarea asp-for="Input.Terms" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Terms" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <div class="form-check">
            <input asp-for="Input.IsUsed" class="form-check-input" />
            <label asp-for="Input.IsUsed" class="form-check-label"></label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Gem ændringer</button>
    <a asp-page="./Index" class="btn btn-secondary">Annuller</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
