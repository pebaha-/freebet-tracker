@page
@model FreebetTracker.Web.Pages.Freebets.IndexModel

@{
    ViewData["Title"] = "Freebets";
}

<div class="container py-4">
    <div class="d-flex justify-content-between
        align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Freebets</h1>
            <p class="text-body-secondary mb-0">
                Oversigt over registrerede freebets
            </p>
        </div>

        <span class="badge text-bg-primary">
            @Model.Freebets.Count i alt
        </span>
    </div>

    <a asp-page="./Create" class="btn btn-primary mb-3">
        Nyt freebet
    </a>

    <div class="table-responsive">
        <table class="table table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">
                        <a asp-page="./Index"
                           asp-route-sortBy="Account"
                           asp-route-sortDescending="@Model.NextSortDescending("Account")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           class="text-decoration-none text-reset">
                            Konto @Model.SortIndicator("Account")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index"
                           asp-route-sortBy="Player"
                           asp-route-sortDescending="@Model.NextSortDescending("Player")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           class="text-decoration-none text-reset">
                            Spiller @Model.SortIndicator("Player")
                        </a>
                    </th>
                    <th scope="col" class="text-end">
                        <a asp-page="./Index"
                           asp-route-sortBy="Amount"
                           asp-route-sortDescending="@Model.NextSortDescending("Amount")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           class="text-decoration-none text-reset">
                            Værdi @Model.SortIndicator("Amount")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index"
                           asp-route-sortBy="ExpiryDate"
                           asp-route-sortDescending="@Model.NextSortDescending("ExpiryDate")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           class="text-decoration-none text-reset">
                            Udløbsdato @Model.SortIndicator("ExpiryDate")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index"
                           asp-route-sortBy="Terms"
                           asp-route-sortDescending="@Model.NextSortDescending("Terms")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           class="text-decoration-none text-reset">
                            Vilkår @Model.SortIndicator("Terms")
                        </a>
                    </th>
                    <th scope="col">
                        <div class="d-flex align-items-center gap-2">
                            <a asp-page="./Index"
                               asp-route-sortBy="IsUsed"
                               asp-route-sortDescending="@Model.NextSortDescending("IsUsed")"
                               asp-route-statusFilter="@Model.StatusFilter"
                               class="text-decoration-none text-reset">
                                Status @Model.SortIndicator("IsUsed")
                            </a>

                            <form method="get" class="m-0">
                                <input type="hidden" name="sortBy"
                                       value="@Model.SortBy" />
                                <input type="hidden" name="sortDescending"
                                       value="@Model.SortDescending.ToString().ToLowerInvariant()" />

                                <select name="statusFilter"
                                        class="form-select form-select-sm"
                                        aria-label="Filtrér efter status"
                                        onchange="this.form.submit()">
                                    <option value="All"
                                            selected="@(Model.StatusFilter == "All")">
                                        Alle
                                    </option>
                                    <option value="Unused"
                                            selected="@(Model.StatusFilter == "Unused")">
                                        Ubrugte
                                    </option>
                                    <option value="Used"
                                            selected="@(Model.StatusFilter == "Used")">
                                        Brugte
                                    </option>
                                </select>
                            </form>
                        </div>
                    </th>
                    <th scope="col">Handlinger</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var freebet in Model.Freebets)
                {
                    <tr>
                        <td>@freebet.Account</td>
                        <td>@freebet.Player</td>
                        <td class="text-end text-nowrap">
                            @freebet.Amount.ToString("N2")
                            kr.
                        </td>
                        <td class="text-nowrap">
                            @if (freebet.ExpiryTimeSpecified)
                            {
                                @freebet.ExpiryDate.ToString("dd-MM-yyyy HH:mm")
                            }
                            else
                            {
                                @freebet.ExpiryDate.ToString("dd-MM-yyyy")
                            }
                        </td>
                        <td>
                            @(freebet.Terms ?? "—")
                        </td>
                        <td>
                            @if (freebet.IsUsed)
                            {
                                <span class="badge text-bg-secondary">Brugt</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Ubrugt</span>
                            }
                        </td>
                        <td>
                            <a asp-page="./Edit"
                               asp-route-id="@freebet.Id"
                               class="btn btn-sm btn-outline-primary">
                                Rediger
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-freebet-id="@freebet.Id"
                                    data-freebet-account="@freebet.Account">
                                Slet
                            </button>
                            @if (!freebet.IsUsed)
                            {
                                <form method="post"
                                      asp-page-handler="MarkAsUsed"
                                      class="d-inline">
                                    <input type="hidden" name="id" value="@freebet.Id" />
                                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                    <input type="hidden" name="sortDescending" value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                                    <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success">
                                        Markér som brugt
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1"
     aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    Slet freebet?
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Luk"></button>
            </div>

            <div class="modal-body">
                Er du sikker på, at du vil slette dette freebet?
                <div class="mt-2 fw-semibold" id="deleteFreebetAccount"></div>
                <div class="text-muted small mt-2">
                    Handlingen kan ikke fortrydes.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Annuller
                </button>

                <form method="post" asp-page-handler="Delete"
                      id="deleteForm">
                    <input type="hidden" name="id" id="deleteFreebetId" />
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                    <input type="hidden" name="sortDescending" value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                    <button type="submit" class="btn btn-danger">
                        <span class="me-1">Slet</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('deleteModal')
        .addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            const id = button.getAttribute('data-freebet-id');
            const account = button.getAttribute('data-freebet-account');

            document.getElementById('deleteFreebetId').value = id;
            document.getElementById('deleteFreebetAccount').textContent =
                account || '';
        });
</script>
