@page
@model FreebetTracker.Web.Pages.Freebets.IndexModel

@{
    ViewData["Title"] = "Freebets";
}

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="status">
            <span class="me-1" aria-hidden="true">✓</span>
            @Model.SuccessMessage
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Luk"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card mb-4">
        <button class="btn text-start p-3"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#reminderSettings"
                aria-expanded="false"
                aria-controls="reminderSettings">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold">Påmindelser</span>

                @if (Model.IsReminderPauseActive)
                {
                    <span class="badge text-bg-warning">
                        pause indtil @Model.PausedUntilUtc!.Value.UtcDateTime.ToString("dd-MM-yyyy")
                    </span>
                }
                else
                {
                    <span class="badge text-bg-success">aktive</span>
                }

                <span class="ms-auto">
                    <span class="collapse-chevron">⌄</span>
                </span>
            </div>
        </button>

        <div class="collapse" id="reminderSettings">
            <div class="card-body border-top pt-3">
                <form method="post"
                      asp-page-handler="SetReminderPause"
                      class="d-flex flex-column flex-sm-row align-items-sm-end gap-2">
                    <div>
                        <label for="resumeDate" class="form-label">
                            Genoptag påmindelser fra
                        </label>
                        <input type="date"
                               id="resumeDate"
                               name="ResumeDate"
                               class="form-control"
                               value="@((Model.PausedUntilUtc?.UtcDateTime.Date ?? Model.TomorrowInBusinessTimeZone).ToString("yyyy-MM-dd"))"
                               required />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Gem dato
                    </button>
                </form>

                @if (Model.PausedUntilUtc is not null)
                {
                    <form method="post"
                          asp-page-handler="ClearReminderPause"
                          class="mt-2">
                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm">
                            Fjern pause
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <a asp-page="./Create" class="btn btn-primary mb-3">
        Nyt freebet
    </a>

    <div class="table-responsive">
        <table class="freebets-table table table-hover align-middle">
            <colgroup>
                <col>
                <col>
                <col>
                <col>
                <col>
                <col>
                <col style="width: 275px">
            </colgroup>
            <thead class="table-light">
                <tr>

                    <th scope="col">
                        <div class="d-flex flex-column gap-1">
                            <a asp-page="./Index"
                               asp-route-sortBy="Account"
                               asp-route-sortDescending="@Model.NextSortDescending("Account")"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-accountFilter="@Model.AccountFilter"
                               asp-route-playerFilter="@Model.PlayerFilter"
                               class="text-decoration-none text-reset">
                                @Model.SortIndicator("Account")
                            </a>

                            <form method="get" class="m-0">
                                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                <input type="hidden" name="sortDescending"
                                       value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                <input type="hidden" name="playerFilter" value="@Model.PlayerFilter" />

                                <select name="accountFilter"
                                        class="form-select form-select-sm"
                                        aria-label="Filtrér efter konto"
                                        onchange="this.form.submit()">
                                    <option value="All"
                                            selected="@(Model.AccountFilter == "All")">
                                        Alle konti
                                    </option>
                                    @foreach (var account in Model.AccountOptions)
                                    {
                                        <option value="@account"
                                                selected="@(Model.AccountFilter == account)">
                                            @account
                                        </option>
                                    }
                                </select>
                            </form>
                        </div>
                    </th>

                    <th scope="col">
                        <div class="d-flex flex-column gap-1">
                            <a asp-page="./Index"
                               asp-route-sortBy="Player"
                               asp-route-sortDescending="@Model.NextSortDescending("Player")"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-accountFilter="@Model.AccountFilter"
                               asp-route-playerFilter="@Model.PlayerFilter"
                               class="text-decoration-none text-reset">
                                @Model.SortIndicator("Player")
                            </a>

                            <form method="get" class="m-0">
                                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                <input type="hidden" name="sortDescending"
                                       value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                <input type="hidden" name="accountFilter" value="@Model.AccountFilter" />

                                <select name="playerFilter"
                                        class="form-select form-select-sm"
                                        aria-label="Filtrér efter spiller"
                                        onchange="this.form.submit()">
                                    <option value="All"
                                            selected="@(Model.PlayerFilter == "All")">
                                        Alle spillere
                                    </option>
                                    @foreach (var player in Model.PlayerOptions)
                                    {
                                        <option value="@player"
                                                selected="@(Model.PlayerFilter == player)">
                                            @player
                                        </option>
                                    }
                                </select>
                            </form>
                        </div>
                    </th>
                    <th scope="col" class="text-end">
                        <a asp-page="./Index"
                           asp-route-sortBy="Amount"
                           asp-route-sortDescending="@Model.NextSortDescending("Amount")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-accountFilter="@Model.AccountFilter"
                           asp-route-playerFilter="@Model.PlayerFilter"
                           class="text-decoration-none text-reset">
                            Værdi @Model.SortIndicator("Amount")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index"
                           asp-route-sortBy="ExpiryDate"
                           asp-route-sortDescending="@Model.NextSortDescending("ExpiryDate")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-accountFilter="@Model.AccountFilter"
                           asp-route-playerFilter="@Model.PlayerFilter"
                           class="text-decoration-none text-reset">
                            Udløbsdato @Model.SortIndicator("ExpiryDate")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index"
                           asp-route-sortBy="Terms"
                           asp-route-sortDescending="@Model.NextSortDescending("Terms")"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-accountFilter="@Model.AccountFilter"
                           asp-route-playerFilter="@Model.PlayerFilter"
                           class="text-decoration-none text-reset">
                            Vilkår @Model.SortIndicator("Terms")
                        </a>
                    </th>

                    <th scope="col">
                        <div class="d-flex flex-column gap-1">
                            <a asp-page="./Index"
                               asp-route-sortBy="IsUsed"
                               asp-route-sortDescending="@Model.NextSortDescending("IsUsed")"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-accountFilter="@Model.AccountFilter"
                               asp-route-playerFilter="@Model.PlayerFilter"
                               class="text-decoration-none text-reset">
                                @Model.SortIndicator("IsUsed")
                            </a>

                            <form method="get" class="m-0">
                                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                <input type="hidden" name="sortDescending" value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="accountFilter" value="@Model.AccountFilter" />
                                <input type="hidden" name="playerFilter" value="@Model.PlayerFilter" />

                                <select name="statusFilter"
                                        class="form-select form-select-sm"
                                        aria-label="Filtrér efter status"
                                        onchange="this.form.submit()">
                                    <option value="All" selected="@(Model.StatusFilter == "All")">
                                        Alle
                                    </option>
                                    <option value="Unused" selected="@(Model.StatusFilter == "Unused")">
                                        Ubrugte
                                    </option>
                                    <option value="Used" selected="@(Model.StatusFilter == "Used")">
                                        Brugte
                                    </option>
                                </select>
                            </form>
                        </div>
                    </th>
                    <th scope="col">Handlinger</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var freebet in Model.Freebets)
                {
                    <tr>
                        <td>@freebet.Account</td>
                        <td>@freebet.Player</td>
                        <td class="text-end text-nowrap">
                            @freebet.Amount.ToString("N2")
                            kr.
                        </td>
                        <td class="text-nowrap">
                            @if (freebet.ExpiryTimeSpecified)
                            {
                                @freebet.ExpiryDate.ToString("dd-MM-yyyy HH:mm")
                            }
                            else
                            {
                                @freebet.ExpiryDate.ToString("dd-MM-yyyy")
                            }
                        </td>
                        <td>
                            @(freebet.Terms ?? "—")
                        </td>
                        <td>
                            @if (freebet.IsUsed)
                            {
                                <span class="badge text-bg-secondary">Brugt</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Ubrugt</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-page="./Edit"
                               asp-route-id="@freebet.Id"
                               class="btn btn-sm btn-outline-primary">
                                Rediger
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-freebet-id="@freebet.Id"
                                    data-freebet-account="@freebet.Account">
                                Slet
                            </button>
                            @if (!freebet.IsUsed)
                            {
                                <form method="post" asp-page-handler="MarkAsUsed" class="d-inline mark-as-used-form">
                                    <input type="hidden" name="id" value="@freebet.Id" />
                                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                    <input type="hidden" name="sortDescending" value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                                    <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                    <input type="hidden" name="accountFilter" value="@Model.AccountFilter" />
                                    <input type="hidden" name="playerFilter" value="@Model.PlayerFilter" />
                                    <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success text-nowrap mark-as-used-button">
                                        Markér som brugt
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Sidenavigation" class="mt-3">
            <div class="d-flex flex-column flex-sm-row
                justify-content-between align-items-center gap-3">

                <span class="text-body-secondary small">
                    Side @Model.PageNumber af @Model.TotalPages
                    (@Model.FilteredCount freebets)
                </span>

                <ul class="pagination mb-0">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDescending="@Model.SortDescending"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-accountFilter="@Model.AccountFilter"
                           asp-route-playerFilter="@Model.PlayerFilter"
                           aria-label="Forrige side">
                            Forrige
                        </a>
                    </li>

                    @for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++)
                    {
                        <li class="page-item @(currentPage == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-pageNumber="@currentPage"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortDescending="@Model.SortDescending"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-accountFilter="@Model.AccountFilter"
                               asp-route-playerFilter="@Model.PlayerFilter"
                               aria-current="@(currentPage == Model.PageNumber ? "page" : null)">
                                @currentPage
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDescending="@Model.SortDescending"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-accountFilter="@Model.AccountFilter"
                           asp-route-playerFilter="@Model.PlayerFilter"
                           aria-label="Næste side">
                            Næste
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    }

</div>

<div class="modal fade" id="deleteModal" tabindex="-1"
     aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    Slet freebet?
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Luk"></button>
            </div>

            <div class="modal-body">
                Er du sikker på, at du vil slette dette freebet?
                <div class="mt-2 fw-semibold" id="deleteFreebetAccount"></div>
                <div class="text-muted small mt-2">
                    Handlingen kan ikke fortrydes.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Annuller
                </button>

                <form method="post" asp-page-handler="Delete"
                      id="deleteForm">
                    <input type="hidden" name="id" id="deleteFreebetId" />
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                    <input type="hidden" name="sortDescending" value="@Model.SortDescending.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                    <input type="hidden" name="accountFilter" value="@Model.AccountFilter" />
                    <input type="hidden" name="playerFilter" value="@Model.PlayerFilter" />
                    <button type="submit" class="btn btn-danger">
                        <span class="me-1">Slet</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="busyOverlay"
     class="position-fixed top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center"
     style="z-index: 2000; background: rgba(255, 255, 255, 0.8);"
     aria-live="polite"
     aria-busy="true">
    <div class="text-center">
        <div class="spinner-border text-success mb-3"
             role="status">
            <span class="visually-hidden">Vent venligst</span>
        </div>
        <p id="busyMessage" class="fw-semibold mb-0">
            Gemmer ændringen …
        </p>
    </div>
</div>

<script>
    document.getElementById('deleteModal')
        .addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            const id = button.getAttribute('data-freebet-id');
            const account = button.getAttribute('data-freebet-account');

            document.getElementById('deleteFreebetId').value = id;
            document.getElementById('deleteFreebetAccount').textContent =
                account || '';
        });

    document.querySelectorAll('.mark-as-used-form')
        .forEach(form => {
            form.addEventListener('submit', function (event) {
                if (form.dataset.submitting === 'true') {
                    event.preventDefault();
                    return;
                }

                form.dataset.submitting = 'true';

                const button = form.querySelector(
                    '.mark-as-used-button'
                );

                if (button) {
                    button.disabled = true;
                    button.textContent = 'Markerer som brugt …';
                }

                document.getElementById('busyOverlay')
                    .classList.remove('d-none');

                document.getElementById('busyOverlay')
                    .classList.add('d-flex');
            });
        });
</script>
